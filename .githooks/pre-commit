#!/bin/sh
# Aedificatoria pre-commit guard.
#
# Checks the staged index against HEAD. Enable once per clone:
#   git config core.hooksPath .githooks
#
# Set up the project first:
#   uv venv .venv && uv pip install -e '.[dev]'
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ -n "${AED_BIN:-}" ] && [ -x "$AED_BIN" ]; then
    exec "$AED_BIN" check --staged
fi

if command -v aed >/dev/null 2>&1; then
    exec aed check --staged
fi

if [ -x "$root/.venv/bin/aed" ]; then
    echo "aed: using workspace .venv; set AED_BIN to a pinned outside-workspace binary" >&2
    exec "$root/.venv/bin/aed" check --staged
fi

echo "aed: not on PATH, AED_BIN unset, and no .venv; skipping architecture check" >&2
exit 0
